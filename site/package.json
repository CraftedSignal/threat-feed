{
  "name": "craftedsignal-threat-feed-site",
  "version": "1.0.0",
  "description": "Public threat feed site for CraftedSignal - Hugo + Tailwind CSS",
  "type": "module",
  "scripts": {
    "dev": "hugo server --buildDrafts --buildFuture",
    "build": "hugo --minify && pagefind --site public",
    "test": "node --test tests/*.test.mjs",
    "clean": "rm -rf public resources"
  },
  "keywords": [
    "hugo",
    "tailwindcss",
    "threat-intelligence",
    "detection-engineering"
  ],
  "author": "CraftedSignal",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "pagefind": "^1.4.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
